# انسخ هذا الملف إلى .env واملأ القيم
# .env لا يُرفع للمستودع أبداً

# ===== Supabase =====
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # السيرفر فقط — لا يصل للمتصفح ولا لـ n8n
DATABASE_URL=

# ===== نموذج اللغة =====
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=                          # نسخة مثبتة بالكامل — لا اسم عام. القيم المسموحة في ALLOWED_MODELS بـ services/agent/llm/config.py
LLM_MAX_TOKENS_PER_CONVERSATION=    # غير مُنفَّذ بعد — يُفعَّل مع الويب هوك
LLM_MAX_SPEND_PER_DAY_USD=          # غير مُنفَّذ بعد — يُفعَّل مع الويب هوك

# ===== واتساب =====
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=                # للتحقق من توقيع الـ webhook

# ===== حدود التشغيل =====
MAX_MESSAGES_PER_NUMBER_PER_DAY=
MAX_CONVERSATION_TURNS=
MAX_CONCESSIONS=3

# ===== التنبيهات =====
ALERT_WEBHOOK_URL=

# ===== البيئة =====
ENVIRONMENT=local                   # local | staging | production
LOG_LEVEL=INFO
