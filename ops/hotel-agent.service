# The WhatsApp webhook agent. INSTALLED on the trial host since 2026-09-27, as
# described in docs/plans/role-fix.md: a dedicated non-root user, the venv
# outside /root, and hardening. It holds no secrets: the only environment
# source is the EnvironmentFile= path, which systemd reads as root before
# dropping privileges, so that file stays 0600 root:root.
#
# Prerequisites, all met on the trial host and needed to rebuild it (the
# commands are in docs/deployment.md, section "الوكيل والـ worker"); without
# them the agent fails to start:
#   - the system user and group hotel-agent,
#   - Python 3.14 and the venv at /opt/hotel/venv (built without touching the
#     repo's own .venv),
#   - the hotel_agent DATABASE_URL in /etc/hotel-admin/agent.env, set by the
#     owner (the value is never written to the repository).
# Each host step is shown to the owner before it is run, and hotel-agent is
# restarted only with the owner's explicit confirmation. To apply a change
# (root):
#   cp ops/hotel-agent.service /etc/systemd/system/hotel-agent.service
#   systemctl daemon-reload
# A change to a comment needs no restart; any other change takes effect at
# the next restart of hotel-agent. Check the process user with
# `journalctl _SYSTEMD_UNIT=hotel-agent.service -n 1 -o verbose` (field _UID).

[Unit]
Description=Hotel Sales Agent webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=hotel-agent
Group=hotel-agent
WorkingDirectory=/srv/hotel-admin/app
EnvironmentFile=/etc/hotel-admin/agent.env
ExecStart=/opt/hotel/venv/bin/uvicorn services.agent.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
